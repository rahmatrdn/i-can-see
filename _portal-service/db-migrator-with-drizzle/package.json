{
  "name": "migration-socmed-db",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "db:generate": "bun scripts/generate.ts && bun scripts/add-sql-comments.ts",
    "db:comments": "bun scripts/add-sql-comments.ts",
    "db:migrate": "bun drizzle-kit migrate",
    "db:seed": "bun src/seeds/index.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun-types": "^1.4.3",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}